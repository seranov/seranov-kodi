<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.seranov.nfoscanner" name="SeraNov NFO Scanner Service" version="1.1.5" provider-name="seranov">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.service" library="service.py"/>

    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="context_menu.py">
                <label>SeraNov: Update NFO Info</label>
                <visible>ListItem.IsFolder + String.IsEqual(System.AddonSetting(service.seranov.nfoscanner,context_menu_root),true)</visible>
            </item>
            <menu>
                <label>SeraNov &gt;</label>
                <item library="context_menu.py">
                    <label>SeraNov: Update NFO Info</label>
                    <visible>ListItem.IsFolder + String.IsEqual(System.AddonSetting(service.seranov.nfoscanner,context_menu_seranov),true)</visible>
                </item>
                <menu>
                    <label>NFO Scanner Service &gt;</label>
                    <item library="context_menu.py">
                        <label>SeraNov: Update NFO Info</label>
                        <visible>ListItem.IsFolder</visible>
                    </item>
                </menu>
            </menu>
        </menu>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">NFO Scanner Service</summary>
        <summary lang="ru_RU">Служба сканирования NFO</summary>
        <description
                lang="en_GB">A background service that scans video folders for movie.nfo and category.nfo files, checking modification dates and re-importing metadata when needed. Supports priority scanning based on user navigation.
        </description>
        <description
                lang="ru_RU">Фоновая служба, которая сканирует видеопапки на наличие файлов movie.nfo и category.nfo, проверяет даты изменения и переимпортирует метаданные при необходимости. Поддерживает приоритетное сканирование на основе навигации пользователя.
        </description>
        <disclaimer lang="en_GB"></disclaimer>
        <language></language>
        <platform>all</platform>
        <license>MIT</license>
        <forum></forum>
        <website>https://github.com/seranov/seranov-kodi</website>
        <email>seranov@yandex.ru</email>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
