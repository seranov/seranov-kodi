<?xml version='1.0' encoding='utf-8'?>
<addons>
    <addon id="repository.seranov" name="Seranov's Kodi Repository" version="1.1.0" provider-name="seranov">
        <extension point="xbmc.addon.repository" name="Seranov's Kodi Repository">
            <dir>
                <info compressed="false">https://raw.githubusercontent.com/seranov/seranov-kodi/main/repo/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/seranov/seranov-kodi/main/repo/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/seranov/seranov-kodi/main/repo/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Seranov's Kodi Add-ons Repository</summary>
            <summary lang="ru_RU">Репозиторий дополнений Kodi от Seranov</summary>
            <description lang="en_GB">Repository for Seranov's Kodi add-ons including service plugins</description>
            <description lang="ru_RU">Репозиторий дополнений Kodi от Seranov, включая служебные плагины</description>
            <disclaimer lang="en_GB" />
            <language />
            <platform>all</platform>
            <license>MIT</license>
            <forum />
            <website>https://github.com/seranov/seranov-kodi</website>
            <email>seranov@yandex.ru</email>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="service.seranov.nfoscanner" name="SeraNov NFO Scanner Service" version="1.1.0" provider-name="seranov">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.service" library="service.py" />
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">NFO Scanner Service</summary>
            <summary lang="ru_RU">Служба сканирования NFO</summary>
            <description lang="en_GB">A background service that scans video folders for movie.nfo and category.nfo files, checking modification dates and re-importing metadata when needed. Supports priority scanning based on user navigation.</description>
            <description lang="ru_RU">Фоновая служба, которая сканирует видеопапки на наличие файлов movie.nfo и category.nfo, проверяет даты изменения и переимпортирует метаданные при необходимости. Поддерживает приоритетное сканирование на основе навигации пользователя.</description>
            <disclaimer lang="en_GB" />
            <language />
            <platform>all</platform>
            <license>MIT</license>
            <forum />
            <website>https://github.com/seranov/seranov-kodi</website>
            <email>seranov@yandex.ru</email>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
</addons>
