<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="context.seranov.screenshots" name="SeraNov Popup Screenshots" version="1.1.1" provider-name="seranov">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.kodi-six" version="0.1.3.1"/>
        <import addon="script.module.routing" version="0.2.3+matrix.1"/>
    </requires>

    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="contextitem_images.py">
                <label>$ADDON[context.seranov.screenshots 32000]</label>
                <visible>true</visible>
            </item>
        </menu>
    </extension>

    <extension point="xbmc.python.script" library="addon.py">
        <provides>executable</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en">Popup Screenshots</summary>
        <description lang="en">Show slideshow of local images and optionally file_id.diz file text content</description>
        <license>GNU General Public License, v2</license>
        <language></language>
        <forum></forum>
        <source></source>
        <website>Kodi.tv</website>
        <email>seranov@yandex.ru</email>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
        <news></news>
    </extension>
</addon>
