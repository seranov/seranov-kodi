                <shadowcolor>66000000</shadowcolor>
                <textoffsetx>5</textoffsetx>
                <aligny>center</aligny>
                <align>center</align>
                <texturefocus border="10" colordiffuse="ff001f00">buttons/shadow_smallbutton.png</texturefocus>
                <texturenofocus border="10" colordiffuse="ff0f1f0f">buttons/shadow_smallbutton.png</texturenofocus>
                <pulseonselect>no</pulseonselect>
                <!--<animation effect="slide" time="0" end="17,0" condition="true">Conditional</animation>-->
            </control>

            <control type="button" id="5504">
                <label>$NUMBER[3]</label>
                <left>5</left>
                <top>415</top>
                <width>40</width>
                <height>200</height>
                <font>font13</font>
                <textcolor>ffe1e1e1</textcolor>
                <focusedcolor>white</focusedcolor>
                <selectedcolor>ffe1e1e1</selectedcolor>
                <shadowcolor>66000000</shadowcolor>
                <textoffsetx>5</textoffsetx>
                <aligny>center</aligny>
                <align>center</align>
                <texturefocus border="10" colordiffuse="ff1f1f00">buttons/shadow_smallbutton.png</texturefocus>
                <texturenofocus border="10" colordiffuse="ff1f1f0f">buttons/shadow_smallbutton.png</texturenofocus>
                <pulseonselect>no</pulseonselect>
